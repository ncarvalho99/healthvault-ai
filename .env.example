# PostgreSQL Connection
DATABASE_URL="postgresql://healthvault:healthvault_secret@127.0.0.1:5432/healthvault?schema=public"

# Authentication & Session Secret (Min 32 characters)
JWT_SECRET="replace_with_a_cryptographically_secure_random_64_character_string"

# Data Encryption Key for AI API Keys (Optional, fallback to JWT_SECRET)
APP_ENCRYPTION_KEY="replace_with_a_cryptographically_secure_random_32_byte_key"

# AI Tool Runtime Settings
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_TOOL_ITERATIONS=8
AI_APPROVAL_TTL_MINUTES=60

# Environment
NODE_ENV="production"
PORT=3000
